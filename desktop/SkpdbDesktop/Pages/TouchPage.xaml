<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SkpdbDesktop.TouchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">

    <Grid Padding="32,24,32,32" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="触摸" Style="{StaticResource PageTitleStyle}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <Grid RowSpacing="16" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <NumberBox x:Name="XBox" Header="X" Minimum="0" Maximum="20000"
                           SpinButtonPlacementMode="Compact" Value="640" />
                <NumberBox x:Name="YBox" Grid.Column="1" Header="Y" Minimum="0" Maximum="20000"
                           SpinButtonPlacementMode="Compact" Value="1400" />
                <NumberBox x:Name="X2Box" Grid.Column="2" Header="终点 X" Minimum="0" Maximum="20000"
                           SpinButtonPlacementMode="Compact" Value="640" />
                <NumberBox x:Name="Y2Box" Grid.Column="3" Header="终点 Y" Minimum="0" Maximum="20000"
                           SpinButtonPlacementMode="Compact" Value="600" />
                <NumberBox x:Name="DurationBox" Grid.Column="4" Header="时长 ms" Minimum="1"
                           Maximum="10000" SpinButtonPlacementMode="Compact" Value="60" />
                <NumberBox x:Name="SlotBox" Grid.Column="5" Header="slot" Minimum="0" Maximum="9"
                           SpinButtonPlacementMode="Compact" Value="9" />

                <StackPanel x:Name="ActionsPanel" Grid.Row="1" Grid.ColumnSpan="6" Orientation="Horizontal" Spacing="8">
                    <Button Content="查询触摸设备" Click="InfoButton_Click" />
                    <Button Content="点击" Style="{StaticResource AccentButtonStyle}"
                            Click="TapButton_Click" />
                    <Button Content="滑动" Click="SwipeButton_Click" />
                    <ProgressRing x:Name="Progress" Width="20" Height="20" IsActive="False" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
            <ScrollViewer Padding="16,12">
                <TextBlock x:Name="OutputText"
                           FontFamily="Cascadia Mono" FontSize="13"
                           IsTextSelectionEnabled="True"
                           TextWrapping="Wrap"
                           Text="先连接设备，然后查询触摸设备或发送手势。" />
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
