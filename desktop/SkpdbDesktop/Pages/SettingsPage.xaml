<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SkpdbDesktop.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">

    <ScrollViewer Padding="32,24,32,32">
        <StackPanel Spacing="16" MaxWidth="900" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="设置" Style="{StaticResource PageTitleStyle}" />
            </StackPanel>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="连接默认值" FontSize="16" FontWeight="SemiBold" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <NumberBox x:Name="KnockPortBox" Header="knock 端口" Minimum="1"
                                   Maximum="65535" SpinButtonPlacementMode="Compact"
                                   Value="39877" />
                        <NumberBox x:Name="TimeoutBox" Grid.Column="1" Header="超时（秒）"
                                   Minimum="1" Maximum="120" SpinButtonPlacementMode="Compact"
                                   Value="10" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="外观" FontSize="16" FontWeight="SemiBold" />
                    <ToggleSwitch x:Name="ThemeToggle" Header="深色主题"
                                  OnContent="深色" OffContent="浅色" />
                </StackPanel>
            </Border>

            <Expander Header="开发选项" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="8">
                    <Button Content="打开离线调试画布" Click="OpenOfflinePreview_Click" />
                </StackPanel>
            </Expander>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="保存设置" Style="{StaticResource AccentButtonStyle}"
                        Click="SaveButton_Click" />
                <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Text="关于 SKPDB" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionText"
                               Style="{StaticResource BodyTextBlockStyle}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
