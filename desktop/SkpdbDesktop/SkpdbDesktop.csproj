<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>SKPDB</AssemblyName>
    <RootNamespace>SkpdbDesktop</RootNamespace>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <BuildChannel Condition="'$(BuildChannel)' == ''">Release</BuildChannel>
    <Version>0.12.46</Version>
    <Version Condition="'$(BuildChannel)' == 'Canary'">0.12.46-canary</Version>
    <AssemblyVersion>0.12.46.0</AssemblyVersion>
    <FileVersion>0.12.46.0</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <UseWinUI>true</UseWinUI>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>
    <PublishSingleFile>false</PublishSingleFile>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <CodePage>65001</CodePage>
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
    <EnableDefaultWindowsAppSdkPRIResourceItems>false</EnableDefaultWindowsAppSdkPRIResourceItems>
    <AppxMSBuildTaskAssembly>$(MSBuildProjectDirectory)\..\build-stubs\AppxTasks\bin\Release\net8.0\AppxTasks.dll</AppxMSBuildTaskAssembly>
  </PropertyGroup>
  <PropertyGroup Condition="'$(BuildChannel)' == 'Canary'">
    <DefineConstants>$(DefineConstants);SKPDB_CANARY</DefineConstants>
  </PropertyGroup>
  <Target Name="ValidateBuildChannel" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(BuildChannel)' != 'Release' and '$(BuildChannel)' != 'Canary'"
           Text="BuildChannel must be Release or Canary." />
  </Target>
  <Target Name="ResolveBuildCommit" BeforeTargets="GetAssemblyAttributes">
    <Exec Condition="'$(GitCommit)' == ''"
          Command="git -C &quot;$(MSBuildProjectDirectory)&quot; rev-parse HEAD"
          ConsoleToMSBuild="true" StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitCommit" />
    </Exec>
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(GitCommit)', '^[0-9a-fA-F]{40}$'))"
           Text="GitCommit must be a full 40-character Git commit hash." />
    <PropertyGroup>
      <GitShortCommit>$([System.String]::Copy('$(GitCommit)').Substring(0, 12).ToLowerInvariant())</GitShortCommit>
      <InformationalVersion>$(Version)+$(GitShortCommit)</InformationalVersion>
    </PropertyGroup>
    <ItemGroup>
      <AssemblyMetadata Include="GitCommit" Value="$(GitCommit)" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250606001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
  </ItemGroup>
</Project>
