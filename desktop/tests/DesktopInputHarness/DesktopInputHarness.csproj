<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <WindowsPackageType>None</WindowsPackageType>
    <ApplicationManifest>../../SkpdbDesktop/app.manifest</ApplicationManifest>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishedClientDirectory Condition="'$(PublishedClientDirectory)' == ''">../../../dist/SKPDB</PublishedClientDirectory>
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
    <EnableDefaultWindowsAppSdkPRIResourceItems>false</EnableDefaultWindowsAppSdkPRIResourceItems>
    <AppxMSBuildTaskAssembly>$(MSBuildProjectDirectory)\..\..\build-stubs\AppxTasks\bin\Release\net8.0\AppxTasks.dll</AppxMSBuildTaskAssembly>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="SKPDB"><HintPath>$(PublishedClientDirectory)/SKPDB.dll</HintPath></Reference>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250606001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
  </ItemGroup>
</Project>
